;;; local.el.sample --- このマシンだけの設定の雛形 -*- lexical-binding: t -*-

;;; Commentary:

;; このファイルを `local.el' という名前でリポジトリ直下にコピーし、要るものだけ
;; 残す。`local.el' は .gitignore してあるので、書いた内容は公開されない。
;;
;; 置くもの:
;;
;;   - 公開リポジトリに書けないもの (社内や tailnet のホスト名など)
;;   - そのマシンにしか無いパス
;;
;; `custom.el' ではなくこちらに置く。custom.el は **git 管理下**なので、
;; 書いたものがそのまま公開される。
;;
;; `init.el' の最後 (user-lisp/ の全モジュールを require した後) に読まれるので、
;; ここでの設定はモジュール側の既定値に必ず勝つ。無ければ何もしない。

;;; Code:

;;; iDeCo (M-x check-ideco) のつなぎ先
;;
;; **設定しないと使えない** (既定は nil)。ideco_server のコンテナは
;; 127.0.0.1 にしか bind していないので、tailscale serve 経由の HTTPS を書く。
;;
;; (setq my:ideco-api-base-url "https://HOST.tailXXXXXX.ts.net:8443")

;;; iDeCo の API キー
;;
;; **鍵はここに書かない。** local.el は git 管理外だが、平文でリポジトリの
;; 中にある。既定では auth-source から引くので、リポジトリの外に置く:
;;
;;   ~/.authinfo (chmod 600) か ~/.authinfo.gpg に 1 行:
;;     machine HOST.tailXXXXXX.ts.net login ideco password <鍵>
;;
;; login の名前を変えたいときだけ:
;; (setq my:ideco-api-key-user "ideco")
;;
;; どうしても auth-source を使わないなら、環境変数から読む手もある:
;; (setq my:ideco-api-key (lambda () (getenv "IDECO_API_KEY")))

;;; 疑似ワークスペース (C-c t) の候補
;;
;; `C-c t' が「新しいタブで開くディレクトリ」としてミニバッファに出す候補。
;; my-editor.el の既定は `~/.emacs.d/' と `~/.config/' の 2 つだけなので、
;; 仕事のプロジェクトはここで足す (**公開リポジトリには書けない**)。
;;
;; 書いた順に出る。候補に無いディレクトリは一覧の末尾の "<free>" から
;; `C-x C-f' と同じように選べるので、ここに全部書く必要は無い。
;;
;; `~/Projects' は my-platform.el のジャンクション / symlink 越しに見ている
;; ので、この書き方のまま mac / Linux でも通る (`c:/Projects' と書くと
;; そのマシンでしか開けない)。
;;
;; (setq my:tab-bar-directories
;;       '("~/Projects/FOO/"
;;         "~/Projects/bar/BAZ/"
;;         "~/.emacs.d/"
;;         "~/.config/"))

;;; Oracle (M-x my:oracle-connect) の接続先
;;
;; **設定しないと使えない** (既定は空で、未設定なら user-error で止まる)。
;; 業務 DB のホスト名・スキーマ名は公開リポジトリに書けないのでここに置く。
;;
;; **パスワードはここに書かない。** auth-source (~/.authinfo.gpg) の
;;
;;   machine HOST port 1521 login USER password <鍵>
;;
;; から引き、無ければミニバッファで訊く。
;;
;; :confirm-write を付けると、書き込む文を送る前に確認する (本番 DB 用)。
;;
;; (setq my:oracle-connections
;;       '(("DEV"  :host "HOST" :port 1521 :service "SERVICE" :user "USER")
;;         ("本番" :host "HOST" :service "SERVICE" :user "USER"
;;                 :confirm-write t)))

;;; SQLcl (M-x my:sql-sqlcl) の既定の接続先
;;
;; SQLcl の connmgr に保存した名前。無くても困らない (ミニバッファの
;; 初期値が空になるだけで、候補は connmgr の保存先から読む)。
;; 認証情報は SQLcl 側にあるので、ここには接続名しか書かない。
;;
;; (setq my:sql-sqlcl-connection "CONNECTION_NAME")

;;; local.el.sample ends here
